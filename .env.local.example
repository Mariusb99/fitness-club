# Copiază acest fișier în .env.local și completează valorile din
# Supabase Project Settings → API (după ce ai creat proiectul și ai
# rulat supabase/schema.sql — vezi README.md pentru pași).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# STRICT server-side — nu-l expune niciodată în cod client sau în git.
# Necesar pentru gestionarea conturilor din pagina Utilizatori
# (creare, editare, resetare parolă, dezactivare, ștergere).
SUPABASE_SERVICE_ROLE_KEY=

# Adresa publică a platformei — apare în linkurile trimise pe email
# (invitație cont nou, resetare parolă). În local rămâne localhost;
# în producție pune domeniul real, de ex. https://fitnessclub.ro
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OPȚIONAL — notificări pe email către antrenori la dezactivarea sau
# reactivarea contului. Fără ele, platforma funcționează normal, doar
# că nu trimite aceste notificări. Cheia se ia de pe resend.com.
RESEND_API_KEY=
EMAIL_FROM=
